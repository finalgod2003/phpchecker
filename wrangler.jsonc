{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phpchecker",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "ratelimits": [
    { "name": "CHECK_LIMITER", "namespace_id": "2026102301", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
